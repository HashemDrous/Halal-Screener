tickerArr = buildTickers()
statusArr = buildStatuses()
gradeArr  = buildGrades()
descArr   = buildDescs()
// ====== END AUTO-GENERATED DATA ======

// ---------------------------------------------------------------------
// 2. LOOKUP  -- find the current chart's ticker in the data
// ---------------------------------------------------------------------
sym   = syminfo.ticker
idx   = array.indexof(tickerArr, sym)
found = idx != -1

status = found ? array.get(statusArr, idx) : -1
grade  = found ? array.get(gradeArr,  idx) : "N/A"
desc   = found ? array.get(descArr,   idx) : "Not in halal database"

// ---------------------------------------------------------------------
// 3. STYLING
// ---------------------------------------------------------------------
labelText  = status == 2 ? "HALAL"        :
             status == 1 ? "QUESTIONABLE" :
             status == 0 ? "HARAM"        : "NO DATA"

gradeSuffix = showGrade and found ? "  " + grade : ""

labelColor = status == 2 ? color.new(color.green,  0) :
             status == 1 ? color.new(color.yellow, 0) :
             status == 0 ? color.new(color.red,    0) : color.new(color.gray, 0)

txtColor   = status == 1 ? color.black : color.white

// ---------------------------------------------------------------------
// 4. ON-CHART LABEL (top-right, follows the last bar)
// ---------------------------------------------------------------------
tooltip = sym + "  [" + grade + "]\n" + desc +
          "\n\nFull reasoning & ratios:\nhalalscreener.app/en/stock/" + sym +
          "\n(copy link into your browser)"

var label tag = na
label.delete(tag)
tag := label.new(
     x         = bar_index,
     y         = high,
     text      = labelText + gradeSuffix,
     color     = labelColor,
     textcolor = txtColor,
     style     = label.style_label_left,
     size      = size.normal,
     tooltip   = tooltip)

// ---------------------------------------------------------------------
// 5. SCREENER OUTPUT (numeric, required for the screener filter)
//    The 2/1/0 value powers the TradingView screener filter
//    (e.g. Halal Status = 2). The readable "HALAL A+" text is shown by
//    the on-chart label above; this plot is the machine-readable value.
// ---------------------------------------------------------------------
plot(status, title="Halal Status (2=halal 1=quest 0=haram)",
     display = display.data_window + display.status_line)
